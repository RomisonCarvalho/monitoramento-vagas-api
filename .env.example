# Conexão com o banco PostgreSQL usada na execução local.
# Em nuvem, o valor é fornecido pelo Google Secret Manager.
DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/nome_do_banco

# Chave exigida pelo endpoint de escrita POST /vagas/.
# Use um valor próprio e nunca versione a chave real.
API_KEY=
